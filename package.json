{
  "name": "kendra-care",
  "version": "1.0.0",
  "description": "Kendra: an elder-centred care circle with a care-continuity escalation engine, routine drift detection, caregiver handover, a bilingual (Kannada/English) voice companion and Gemini-assisted insights.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "keywords": [
    "elderly-care",
    "medication-reminder",
    "caregiver",
    "gemini",
    "accessibility"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "firebase-admin": "^14.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
