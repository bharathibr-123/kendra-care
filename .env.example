# Copy to .env for local development (never commit real values).

# Required in production: 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Gemini (Google AI Studio) — enables prescription scanning and AI-written care briefs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP with an App Password (Google Account > Security > App passwords).
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Public URL of the deployed app (used for the button in reminder emails).
PUBLIC_URL=

# Shared secret for POST /api/cron/tick (external scheduler such as cron-job.org).
CRON_SECRET=

# Optional: Google Cloud Firestore (free Firebase Spark plan) for persistent storage.
# Easiest: paste the entire downloaded service-account JSON on one line here.
FIREBASE_SERVICE_ACCOUNT=
# Alternatively, the three fields separately:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

DEFAULT_TIMEZONE=Asia/Kolkata
